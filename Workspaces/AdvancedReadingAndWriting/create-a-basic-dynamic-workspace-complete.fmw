#! START_DEST_HEADER GENERIC GENERIC_2
DEFAULT_MACRO DestDataset_GENERIC_2 $(DestDataset_GENERIC)
GUI DIRNAME DestDataset_GENERIC_2 Destination Generic (Any Format) Folder:
DEFAULT_MACRO GENERIC_OUT_FME_GROUP_NAMED1_GENERIC_2 
GUI OPTIONAL DISCLOSUREGROUP GENERIC_OUT_FME_GROUP_NAMED1_GENERIC_2 GENERIC_OUT_FORMAT_GENERIC_2%GENERIC_OUT_BASE_NAME_GENERIC_2 Writer Parameters
DEFAULT_MACRO GENERIC_OUT_FORMAT_GENERIC_2 $(FORMAT_GENERIC)
GENERIC_2_FORMAT "$(GENERIC_OUT_FORMAT_GENERIC_2)"
GUI WRITERPICK GENERIC_OUT_FORMAT_GENERIC_2 Output Format:
DEFAULT_MACRO GENERIC_OUT_BASE_NAME_GENERIC_2 
GENERIC_2_BASE_NAME "$(GENERIC_OUT_BASE_NAME_GENERIC_2)"
GUI OPTIONAL TEXT GENERIC_OUT_BASE_NAME_GENERIC_2 Base filename
#!----------------------------------------------------------------------
#! Are we to operate in dynamic schema mode?
#!----------------------------------------------------------------------
#DEFAULT_VALUE DYNAMIC_SCHEMA No
#-GUI CHOICE DYNAMIC_SCHEMA No%Yes Dynamic Schema Mode
DEFAULT_MACRO GENERIC_OUT_FME_GROUP_NAMED2_GENERIC_2 
GUI OPTIONAL DISCLOSUREGROUP GENERIC_OUT_FME_GROUP_NAMED2_GENERIC_2 GENERIC_OUT_MIME_TYPE_GENERIC_2 FME Flow Parameters
# =====================================================================
# Set the mime type. Note -- it is actually only used inside of workspaces
# as a FORMAT_PARAMETER which even then is parsed only by the FME Flow
# Repository Manager
# The list of mime types below is far from complete but was determined from
# http://en.wikipedia.org/wiki/Internet_media_type as the common types.
DEFAULT_MACRO GENERIC_OUT_MIME_TYPE_GENERIC_2 text/plain
GENERIC_2_MIME_TYPE "$(GENERIC_OUT_MIME_TYPE_GENERIC_2)"
GUI OPTIONAL STRING_OR_CHOICE GENERIC_OUT_MIME_TYPE_GENERIC_2 application/json%application/pdf%application/x-dvi%application/x-shockwave-flash%application/x-rar-compressed%application/x-tar%application/zip%audio/mpeg%audio/vnd.rn-realaudio%audio/x-ms-wma%audio/x-wav%image/gif%image/jpeg%image/png%image/svg+xml%image/tiff%text/css%text/csv%text/html%text/plain%text/xml%video/mp4%video/mpeg%video/quicktime%video/x-ms-wmv MIME Type:
DEFAULT_MACRO GENERIC_OUT_SPATIAL_GROUP_GENERIC_2 
GUI OPTIONAL DISCLOSUREGROUP GENERIC_OUT_SPATIAL_GROUP_GENERIC_2 GENERIC_OUT_COORDINATE_SYSTEM_GENERIC_2 Spatial
DEFAULT_MACRO GENERIC_OUT_COORDINATE_SYSTEM_GENERIC_2 
GENERIC_2_COORDINATE_SYSTEM "$(GENERIC_OUT_COORDINATE_SYSTEM_GENERIC_2)"
GUI OPTIONAL COORDSYS GENERIC_OUT_COORDINATE_SYSTEM_GENERIC_2 Coordinate System:
# ============================================================================
# Opt in for destination dataset type vs format type validation
DEFAULT_MACRO GENERIC_OUT_DESTINATION_DATASETTYPE_VALIDATION_GENERIC_2 Yes
GENERIC_2_DESTINATION_DATASETTYPE_VALIDATION "$(GENERIC_OUT_DESTINATION_DATASETTYPE_VALIDATION_GENERIC_2)"
# ============================================================================
GENERIC_2_GENERATE_FME_BUILD_NUM 26333
DEFAULT_MACRO READER_SCHEMAS_TO_SKIP_GENERIC_2
GENERIC_2_READER_SCHEMAS_TO_SKIP $(READER_SCHEMAS_TO_SKIP_GENERIC_2)
GENERIC_2_DATASET "$(DestDataset_GENERIC_2)"
