GML_3_IGNORE_APPLICATON_SCHEMA "$(GML_IN_IGNORE_APPLICATON_SCHEMA_GML_3)"
GUI ACTIVECHOICE GML_IN_IGNORE_APPLICATON_SCHEMA_GML_3 no,GML_IN_GML_FEATURE_ELEMENTS_GML_3%yes,GML_IN_XSD_DOC_GML_3,GML_IN_VALIDATE_DATASET_GML_3,GML_IN_FEATURE_TYPES_SCHEMA_MODE,GML_IN_SKIP_SCHEMA_LOCATION_IN_DATASET_GML_3,GML_IN_MAP_FEATURE_COLLECTION_GML_3,GML_IN_FEATURE_PROPERTIES_READER_GML_3,GML_IN_ATTRIBUTE_HANDLING_GML_3,GML_IN_GML_READER_GROUP_GML_3 Ignore Application Schema:
