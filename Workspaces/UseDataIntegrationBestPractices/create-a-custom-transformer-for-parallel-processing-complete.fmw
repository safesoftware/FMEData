OSM_2_CATEGORIES_QUERY "$(OSM_IN_CATEGORIES_QUERY_OSM_2)"
DEFAULT_MACRO OSM_IN_HANDLE_MULTI_OSM_2 SELECT_FIRST
OSM_2_HANDLE_MULTI "$(OSM_IN_HANDLE_MULTI_OSM_2)"
DEFAULT_MACRO OSM_IN_SCAN_ALL_FEATURES_FOR_SCHEMA_OSM_2 no
OSM_2_SCAN_ALL_FEATURES_FOR_SCHEMA "$(OSM_IN_SCAN_ALL_FEATURES_FOR_SCHEMA_OSM_2)"
#============================================================
# THIS GROUP GIVES EXTRA OPTIONS TO THE USERS
