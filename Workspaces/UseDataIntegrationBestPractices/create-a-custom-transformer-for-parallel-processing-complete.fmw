FFS_2_ATTRIBUTE_TYPE_SCANNING "$(FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2)"
GUI LOOKUP_CHOICE FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2 Yes,YES%No,NO Scan for Types
# ========================================================================
# The following parameter indicates if we should store scanned
# metadata and store it with the dataset.
DEFAULT_MACRO FFS_OUT_STORE_SCANNED_METADATA_FFS_2 No
FFS_2_STORE_SCANNED_METADATA "$(FFS_OUT_STORE_SCANNED_METADATA_FFS_2)"
GUI CHOICE FFS_OUT_STORE_SCANNED_METADATA_FFS_2 Yes%No Store Scanned Metadata
DEFAULT_MACRO FFS_OUT_SPATIAL_GROUP_FFS_2 
