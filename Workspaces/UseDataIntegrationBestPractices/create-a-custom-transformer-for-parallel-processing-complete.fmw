FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE OPENFILEGDB OPENFILEGDB_1::PostcodeBoundaries multi_reader_keyword,$(DATASET_KEYWORD_OPENFILEGDB_1) TO FME_GENERIC ::PostcodeBoundaries ALIAS_GEOMETRY    ROUTE OPENFILEGDB OPENFILEGDB_1::PostalAddress multi_reader_keyword,$(DATASET_KEYWORD_OPENFILEGDB_1) TO FME_GENERIC ::PostalAddress ALIAS_GEOMETRY    ROUTE OSM OSM_2::building multi_reader_keyword,$(DATASET_KEYWORD_OSM_2) TO FME_GENERIC ::building ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
OPENFILEGDB_1_MERGE_DEF OPENFILEGDB_1::PostcodeBoundaries EXACT PostcodeBoundaries DEFLINE openfilegdb_type,geodb_polygon,openfilegdb_where_wwjd,,fme_attribute_reading,defined,CFSAUID,text<openparen>3<closeparen>,SHAPE_Length,double,SHAPE_Area,double
OPENFILEGDB_1_MERGE_DEF OPENFILEGDB_1::PostalAddress EXACT PostalAddress DEFLINE openfilegdb_type,geodb_point,openfilegdb_where_wwjd,,fme_attribute_reading,defined,GlobalID,guid,OWNERNM1,text<openparen>150<closeparen>,OWNERNM2,text<openparen>150<closeparen>,PSTLADDRESS,text<openparen>250<closeparen>,PSTLCITY,text<openparen>100<closeparen>,PSTLPROV,text<openparen>25<closeparen>,INTSTATE,text<openparen>5<closeparen>,INTPSTLCD,text<openparen>10<closeparen>,COUNTRY,text<openparen>100<closeparen>,REPRESENT,text<openparen>14<closeparen>,STATUS,text<openparen>9<closeparen>,LASTUPDATE,datetime,LASTEDITOR,text<openparen>50<closeparen>,POSTALCODE,text<openparen>6<closeparen>
OSM_2_MERGE_DEF OSM_2::building EXACT building
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "building_OSM_2 Splitter"    INPUT FEATURE_TYPE building    OUTPUT FEATURE_TYPE building_OSM_2
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "PostalAddress_OPENFILEGDB_1 Splitter"    INPUT FEATURE_TYPE PostalAddress    OUTPUT FEATURE_TYPE PostalAddress_OPENFILEGDB_1
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "PostcodeBoundaries_OPENFILEGDB_1 Splitter"    INPUT FEATURE_TYPE PostcodeBoundaries
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} GeometryFilterFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { GeometryFilter }    INPUT  FEATURE_TYPE building_OSM_2    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    FILTER_TYPES { Polygon,Donut,MultiArea }    INSTANCES { INSTANCE }    OUTPUT { <UNFILTERED> FEATURE_TYPE GeometryFilter_<UNFILTERED>  }    OUTPUT { Polygon FEATURE_TYPE GeometryFilter_Polygon  }    OUTPUT { Donut FEATURE_TYPE GeometryFilter_Donut  }    OUTPUT { MultiArea FEATURE_TYPE GeometryFilter_MultiArea  }
FACTORY_DEF * TeeFactory   FACTORY_NAME "GeometryFilter <UNFILTERED> Transformer Output Nuker"   INPUT FEATURE_TYPE GeometryFilter_<UNFILTERED>
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector }    INPUT  FEATURE_TYPE GeometryFilter_Polygon    INPUT  FEATURE_TYPE GeometryFilter_Donut    INPUT  FEATURE_TYPE GeometryFilter_MultiArea    ENGINE { SOURCE "" DESTINATION "UTM83-10" }    GEOM_NAME_SELECTION { FME_ALL_GEOMETRIES }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE Reprojector_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
