GUI OPTIONAL DISCLOSUREGROUP OSM_IN_FME_GROUP_NAMED2_OSM_2 OSM_IN_REMOVE_NODE_LIST_OSM_2%OSM_IN_ALLOW_DUPLICATE_COORDINATES_OSM_2%OSM_IN_CACHE_WAYS_AND_RELATIONS_OSM_2%OSM_IN_OUTPUT_INCOMPLETE_WAYS_AND_RELATIONS_OSM_2 Reader Options
