OSM_2_ALLOW_DUPLICATE_COORDINATES "$(OSM_IN_ALLOW_DUPLICATE_COORDINATES_OSM_2)"
GUI OPTIONAL CHECKBOX OSM_IN_ALLOW_DUPLICATE_COORDINATES_OSM_2 yes%no Allow Consecutive Duplicate Coordinates in Ways
DEFAULT_MACRO OSM_IN_CACHE_WAYS_AND_RELATIONS_OSM_2 no
OSM_2_CACHE_WAYS_AND_RELATIONS "$(OSM_IN_CACHE_WAYS_AND_RELATIONS_OSM_2)"
GUI OPTIONAL CHECKBOX OSM_IN_CACHE_WAYS_AND_RELATIONS_OSM_2 yes%no Nodes, Ways, and Relation blocks in Non-Standard Order:
DEFAULT_MACRO OSM_IN_OUTPUT_INCOMPLETE_WAYS_AND_RELATIONS_OSM_2 no
