FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE OPENFILEGDB OPENFILEGDB_1::PostcodeBoundaries multi_reader_keyword,$(DATASET_KEYWORD_OPENFILEGDB_1) TO FME_GENERIC ::PostcodeBoundaries ALIAS_GEOMETRY    ROUTE OPENFILEGDB OPENFILEGDB_1::PostalAddress multi_reader_keyword,$(DATASET_KEYWORD_OPENFILEGDB_1) TO FME_GENERIC ::PostalAddress ALIAS_GEOMETRY    ROUTE OSM OSM_2::building multi_reader_keyword,$(DATASET_KEYWORD_OSM_2) TO FME_GENERIC ::building ALIAS_GEOMETRY    ROUTE MITAB MITAB_2::Zones multi_reader_keyword,$(DATASET_KEYWORD_MITAB_2) TO FME_GENERIC ::Zones ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
OPENFILEGDB_1_MERGE_DEF OPENFILEGDB_1::PostcodeBoundaries EXACT PostcodeBoundaries DEFLINE openfilegdb_type,geodb_polygon,openfilegdb_where_wwjd,,fme_attribute_reading,defined,CFSAUID,text<openparen>3<closeparen>,SHAPE_Length,double,SHAPE_Area,double
OPENFILEGDB_1_MERGE_DEF OPENFILEGDB_1::PostalAddress EXACT PostalAddress DEFLINE openfilegdb_type,geodb_point,openfilegdb_where_wwjd,,fme_attribute_reading,defined,GlobalID,guid,OWNERNM1,text<openparen>150<closeparen>,OWNERNM2,text<openparen>150<closeparen>,PSTLADDRESS,text<openparen>250<closeparen>,PSTLCITY,text<openparen>100<closeparen>,PSTLPROV,text<openparen>25<closeparen>,INTSTATE,text<openparen>5<closeparen>,INTPSTLCD,text<openparen>10<closeparen>,COUNTRY,text<openparen>100<closeparen>,REPRESENT,text<openparen>14<closeparen>,STATUS,text<openparen>9<closeparen>,LASTUPDATE,datetime,LASTEDITOR,text<openparen>50<closeparen>,POSTALCODE,text<openparen>6<closeparen>
OSM_2_MERGE_DEF OSM_2::building EXACT building
MITAB_2_MERGE_DEF MITAB_2::Zones EXACT Zones
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "building_OSM_2 Splitter"    INPUT FEATURE_TYPE building    OUTPUT FEATURE_TYPE building_OSM_2
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "PostalAddress_OPENFILEGDB_1 Splitter"    INPUT FEATURE_TYPE PostalAddress    OUTPUT FEATURE_TYPE PostalAddress_OPENFILEGDB_1
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "PostcodeBoundaries_OPENFILEGDB_1 Splitter"    INPUT FEATURE_TYPE PostcodeBoundaries
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "Zones_MITAB_2 Splitter"    INPUT FEATURE_TYPE Zones    OUTPUT FEATURE_TYPE Zones_MITAB_2
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} GeometryFilterFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { GeometryFilter }    INPUT  FEATURE_TYPE building_OSM_2    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    FILTER_TYPES { Polygon,Donut,MultiArea }    INSTANCES { INSTANCE }    OUTPUT { <UNFILTERED> FEATURE_TYPE GeometryFilter_<UNFILTERED>  }    OUTPUT { Polygon FEATURE_TYPE GeometryFilter_Polygon  }    OUTPUT { Donut FEATURE_TYPE GeometryFilter_Donut  }    OUTPUT { MultiArea FEATURE_TYPE GeometryFilter_MultiArea  }
FACTORY_DEF * TeeFactory   FACTORY_NAME "GeometryFilter <UNFILTERED> Transformer Output Nuker"   INPUT FEATURE_TYPE GeometryFilter_<UNFILTERED>
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector }    INPUT  FEATURE_TYPE GeometryFilter_Polygon    INPUT  FEATURE_TYPE GeometryFilter_Donut    INPUT  FEATURE_TYPE GeometryFilter_MultiArea    ENGINE { SOURCE "" DESTINATION "UTM83-10" }    GEOM_NAME_SELECTION { FME_ALL_GEOMETRIES }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE Reprojector_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Reprojector_<Rejected> INPUT FEATURE_TYPE Reprojector_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Reprojector<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} OverlayFactory    FACTORY_NAME { PointOnAreaOverlayer }    INPUT POINT FEATURE_TYPE PostalAddress_OPENFILEGDB_1    INPUT POLYGON FEATURE_TYPE Reprojector_REPROJECTED    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    OVERLAP_COUNT_ATTRIBUTE { "_overlaps" }    DEAGGREGATE_INPUT { Yes }    MERGE_ATTRS { "YES" }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "ORIGINAL_IF_CONFLICT" }    INCOMING_PREFIX { "<Unused>" }    LIST_NAME { "<Unused>" }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    CANDIDATE_LIST_NAME { "<Unused>" }    CANDIDATE_LIST_ATTRS_TO_INCLUDE { <Unused> }    CANDIDATE_LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MODE COMPLETE    OVERLAY_TYPE POINT_ON_AREA    POLYS_FIRST { "NO" }    REJECT_INVALID_GEOM YES    OUTPUT { POLYGON FEATURE_TYPE PointOnAreaOverlayer_AREA         }    OUTPUT { ILLEGAL_GEOM FEATURE_TYPE PointOnAreaOverlayer_<REJECTED>         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME PointOnAreaOverlayer_<Rejected> INPUT FEATURE_TYPE PointOnAreaOverlayer_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, PointOnAreaOverlayer<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE PointOnAreaOverlayer_AREA    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_overlaps<closeparen>,Tester)" > 0 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }    OUTPUT { FAILED FEATURE_TYPE Tester_FAILED         }
# -------------------------------------------------------------------------
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { AttributeCreator_Creator }    OUTPUT { FEATURE_TYPE AttributeCreator_____CREATED______ }
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE AttributeCreator_____CREATED______ }    INPUT  FEATURE_TYPE Tester_FAILED    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "_ValidationAddress" "SET_TO" "No<space>matching<space>address<space>point" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} GeometryValidationFactory    FACTORY_NAME { GeometryValidator }    INPUT  FEATURE_TYPE Tester_PASSED    INPUT  FEATURE_TYPE AttributeCreator_OUTPUT    TYPE_REPAIR_NEW_TOLERANCE Yes    ISSUE_ATTR_NAME { "_issues" }    REPAIR_MODE { YES }    SUMMARY_MODE { DETAILED_SUMMARY }    VALIDATION_ISSUE { AREA_ORIENTATION AREA_ORIENTATION]VALID }      VALIDATION_ISSUE { CONSECUTIVE_IDENTICAL_VERTICES_2D CHECK_Z]YES]TOLERANCE]0.0 }      VALIDATION_ISSUE { MISSING_TEXTURE_COORDINATES  }      VALIDATION_ISSUE { MISSING_VERTEX_NORMALS  }      VALIDATION_ISSUE { NAN_REMOVAL PROCESS_MEASURE]NO }      VALIDATION_ISSUE { NULL_REMOVAL  }      VALIDATION_ISSUE { OGC_VALID_CHECK OGC_VERSION]V1.1.0]SPATIAL_SUBSET]<Unused>]REQUIRE_SIMPLE]Yes]LEGACY_OGC]No }      VALIDATION_ISSUE { OGC_VALID_CHECK OGC_VERSION]V1.2.0]SPATIAL_SUBSET]<Unused>]REQUIRE_SIMPLE]No]LEGACY_OGC]No }      VALIDATION_ISSUE { PLANAR_SURFACE CHECK_AREA]DO_NOT_CHECK_AREA]TOLERANCE_MODE]AUTO]TOLERANCE]<Unused>]ANGULAR_TOLERANCE_MODE]AUTO]ANGULAR_TOLERANCE]<Unused> }      VALIDATION_ISSUE { SELF_INTERSECTING CHECK_HOLE_TOUCHING_POLYGON]No]CONNECT_Z_MODE_SI]FIRST_WINS]SELF_INTERSECTION_TOLERANCE]None]VALIDATE_CURVES_POINTS]Yes]INTERSECT_ACROSS_MULTIS]No }      VALIDATION_ISSUE { SHELL_VALIDATION FLIP_APPEARANCE_MODE]FLIP_APPEARANCES }      VALIDATION_ISSUE { SOLID_VOID_REPAIR  }      VALIDATION_ISSUE { TYPE_REPAIR CONNECT_Z_MODE]FIRST_WINS]ARC_ENDPOINT_TOLERANCE_MODE]Auto]ARC_ENDPOINT_TOLERANCE]<Unused> }      VALIDATION_ISSUE { MISMATCHED_DIMENSIONS FORCE_DIMENSION]2D]MISMATCHED_Z_VAL]<Unused> }      VALIDATION_ISSUE { MISSING_MEASURES_AND_ELEVATIONS MISSING_VALUES_MODE]SENTINEL]MISSING_MEASURES_MODE]<Unused>]SENTINEL_VALUE]0]LENGTH_DIMENSION]<Unused> }      VALIDATION_ISSUE { SURFACE_ORIENTATION  }      VALIDATION_ISSUE { SOLID_ORIENTATION  }    SUPPORT_OGC_REPAIR Yes    REJECT_INVALID Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { VALID FEATURE_TYPE GeometryValidator_PASSED        }    OUTPUT { INVALID FEATURE_TYPE GeometryValidator_FAILED        }    OUTPUT { REPAIRED FEATURE_TYPE GeometryValidator_REPAIRED        }    OUTPUT { ISSUE_LOCATIONS FEATURE_TYPE GeometryValidator_ISSUE_LOCATIONS        }    OUTPUT { INVALID_PARTS FEATURE_TYPE GeometryValidator_INVALID_PARTS        }    OUTPUT { REJECTED FEATURE_TYPE GeometryValidator_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME GeometryValidator_<Rejected> INPUT FEATURE_TYPE GeometryValidator_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, GeometryValidator<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} SpatialRelationshipFactory    FACTORY_NAME { SpatialRelator }    INPUT BASE FEATURE_TYPE GeometryValidator_PASSED    INPUT BASE FEATURE_TYPE GeometryValidator_FAILED    INPUT BASE FEATURE_TYPE GeometryValidator_REPAIRED    INPUT BASE FEATURE_TYPE GeometryValidator_ISSUE_LOCATIONS    INPUT BASE FEATURE_TYPE GeometryValidator_INVALID_PARTS    INPUT CANDIDATE FEATURE_TYPE Zones_MITAB_2    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    PREDICATE { "INTERSECTS" }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    SUCCESS_ATTR { "_related_candidates" }    REJECT_INVALID_GEOM Yes    REJECT_INVALID_PREDICATES Yes    REJECT_RASTERS No    ALLOW_NULLS Yes    CUSTOM_MULTI_HANDLING { Yes }    CURVE_BOUNDARY_RULE { ENDPOINTS_MOD2 }    CALCULATE_CARDINALITY { No }    MERGE_INCOMING_ATTR { NO }    ATTR_ACCUM_MODE { <Unused> }    ATTR_CONFLICT_RES { <Unused> }    INCOMING_ATTR_PREFIX { "<Unused>" }    IGNORE_NULLS { <Unused> }    OUTPUT { TAGGED FEATURE_TYPE SpatialRelator_Output        }    OUTPUT { REJECTED FEATURE_TYPE SpatialRelator_<Rejected>        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME SpatialRelator_<Rejected> INPUT FEATURE_TYPE SpatialRelator_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, SpatialRelator<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { TestFilter_INPUT }    INPUT  FEATURE_TYPE SpatialRelator_Output    OUTPUT { FEATURE_TYPE TestFilter_INPUTLINE }
FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter } INPUT FEATURE_TYPE TestFilter_INPUTLINE PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_related_candidates<closeparen>,TestFilter) = 0 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_Unzoned TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_related_candidates<closeparen>,TestFilter) > 1 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE TestFilter_Multi-Zoned OUTPUT FAILED FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>
# -------------------------------------------------------------------------
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { AttributeCreator_2_Creator }    OUTPUT { FEATURE_TYPE AttributeCreator_2_____CREATED______ }
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_2 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE AttributeCreator_2_____CREATED______ }    INPUT  FEATURE_TYPE TestFilter_Unzoned    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "_ValidationZones" "SET_TO" "Unzoned<space>building" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_2_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { AttributeCreator_3_Creator }    OUTPUT { FEATURE_TYPE AttributeCreator_3_____CREATED______ }
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_3 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE AttributeCreator_3_____CREATED______ }    INPUT  FEATURE_TYPE TestFilter_Multi-Zoned    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "_ValidationZones" "SET_TO" "Overlapping<space>zones<space>building" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_3_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Junction }    INPUT  FEATURE_TYPE AttributeCreator_2_OUTPUT    INPUT  FEATURE_TYPE AttributeCreator_3_OUTPUT    INPUT  FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>    OUTPUT { FEATURE_TYPE Junction_Output         }
