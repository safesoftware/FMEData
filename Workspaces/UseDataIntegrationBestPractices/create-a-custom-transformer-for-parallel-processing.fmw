DEFAULT_MACRO FFS_OUT_PASSPHRASE_FFS_2 
FFS_2_PASSPHRASE "$(FFS_OUT_PASSPHRASE_FFS_2)"
GUI LITERAL OPTIONAL PASSWORD_ENCODED FFS_OUT_PASSPHRASE_FFS_2 Password:
# ============================================================================
DEFAULT_MACRO FFS_OUT_COMPRESSION_GROUP_FFS_2 FME_DISCLOSURE_OPEN
FFS_2_COMPRESSION_GROUP "$(FFS_OUT_COMPRESSION_GROUP_FFS_2)"
GUI OPTIONAL DISCLOSUREGROUP FFS_OUT_COMPRESSION_GROUP_FFS_2 FFS_OUT_COMPRESSION_METHOD_FFS_2%FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2 Compression
# ============================================================================
# Set the compression method (NONE|ZSTD|DEFLATE|LZ4)
DEFAULT_MACRO FFS_OUT_COMPRESSION_METHOD_FFS_2 LZ4
FFS_2_COMPRESSION_METHOD "$(FFS_OUT_COMPRESSION_METHOD_FFS_2)"
GUI ACTIVECHOICE_LOOKUP FFS_OUT_COMPRESSION_METHOD_FFS_2 LZ4<space><openparen>fastest<closeparen>,LZ4,FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2%Zstandard,ZSTD%None,NONE,FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2 Compression Method:
# ============================================================================
# Set the Zstd compression level
DEFAULT_MACRO FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2 <Unused>
FFS_2_ZSTD_COMPRESSION_LEVEL "$(FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2)"
GUI INT_OR_CHOICE FFS_OUT_ZSTD_COMPRESSION_LEVEL_FFS_2 1%2%3%4%5%6%7%8%9 Compression Level:
# ========================================================================
# The following parameter indicates if features should have all user
# attributes not listed on the DEF line removed before they are saved.
# If yes, the unlisted attributes are stripped.
DEFAULT_MACRO FFS_OUT_REQUIRES_FEATURE_TABLES_FFS_2 No
FFS_2_REQUIRES_FEATURE_TABLES "$(FFS_OUT_REQUIRES_FEATURE_TABLES_FFS_2)"
GUI CHOICE FFS_OUT_REQUIRES_FEATURE_TABLES_FFS_2 Yes%No Enforce Strict Schema
# ========================================================================
# The following parameter indicates if we should store scanned
# schema(s) of all input attributes not listed on the defline.
DEFAULT_MACRO FFS_OUT_STORE_SCANNED_SCHEMA_FFS_2 No
FFS_2_STORE_SCANNED_SCHEMA "$(FFS_OUT_STORE_SCANNED_SCHEMA_FFS_2)"
GUI ACTIVECHOICE FFS_OUT_STORE_SCANNED_SCHEMA_FFS_2 Yes%No,FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2 Store Scanned Schema
# ========================================================================
# The following parameter indicates how we should store scanned
# types of all input attributes not listed on the defline.
DEFAULT_MACRO FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2 <Unused>
FFS_2_ATTRIBUTE_TYPE_SCANNING "$(FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2)"
GUI LOOKUP_CHOICE FFS_OUT_ATTRIBUTE_TYPE_SCANNING_FFS_2 Yes,YES%No,NO Scan for Types
# ========================================================================
# The following parameter indicates if we should store scanned
# metadata and store it with the dataset.
DEFAULT_MACRO FFS_OUT_STORE_SCANNED_METADATA_FFS_2 No
FFS_2_STORE_SCANNED_METADATA "$(FFS_OUT_STORE_SCANNED_METADATA_FFS_2)"
GUI CHOICE FFS_OUT_STORE_SCANNED_METADATA_FFS_2 Yes%No Store Scanned Metadata
DEFAULT_MACRO FFS_OUT_SPATIAL_GROUP_FFS_2 
GUI OPTIONAL DISCLOSUREGROUP FFS_OUT_SPATIAL_GROUP_FFS_2 FFS_OUT_COORDINATE_SYSTEM_FFS_2%FFS_OUT_INDEXED_FFS_2 Spatial
DEFAULT_MACRO FFS_OUT_COORDINATE_SYSTEM_FFS_2 
FFS_2_COORDINATE_SYSTEM "$(FFS_OUT_COORDINATE_SYSTEM_FFS_2)"
GUI OPTIONAL COORDSYS FFS_OUT_COORDINATE_SYSTEM_FFS_2 Coordinate System:
# ============================================================================
# Ask if we should make a spatial index
DEFAULT_MACRO FFS_OUT_INDEXED_FFS_2 no
FFS_2_INDEXED "$(FFS_OUT_INDEXED_FFS_2)"
GUI ACTIVECHOICE FFS_OUT_INDEXED_FFS_2 Yes,FFS_OUT_COMPRESSION_GROUP_FFS_2%no,++FFS_OUT_COMPRESSION_GROUP_FFS_2+FME_DISCLOSURE_OPEN Create Spatial Index:
DEFAULT_MACRO FFS_OUT_ADVANCED_GROUP_FFS_2 
GUI OPTIONAL DISCLOSUREGROUP FFS_OUT_ADVANCED_GROUP_FFS_2 FME_DISCLOSURE_CLOSED%FFS_OUT_MAX_FILE_SIZE_FFS_2 Advanced
# ========================================================================
# The following parameter specifies the maximum size for FFS files. If
# it is specified, the FFS writer will split up the output into multiple
# FFS files.
DEFAULT_MACRO FFS_OUT_MAX_FILE_SIZE_FFS_2 
FFS_2_MAX_FILE_SIZE "$(FFS_OUT_MAX_FILE_SIZE_FFS_2)"
GUI OPTIONAL INTEGER FFS_OUT_MAX_FILE_SIZE_FFS_2 Maximum FFS File Size, in Bytes
# ============================================================================
# Opt out of destination dataset type vs format type validation
DEFAULT_MACRO FFS_OUT_DESTINATION_DATASETTYPE_VALIDATION_FFS_2 No
FFS_2_DESTINATION_DATASETTYPE_VALIDATION "$(FFS_OUT_DESTINATION_DATASETTYPE_VALIDATION_FFS_2)"
DEFAULT_MACRO FFS_OUT_COORDINATE_SYSTEM_GRANULARITY_FFS_2 FEATURE
FFS_2_COORDINATE_SYSTEM_GRANULARITY "$(FFS_OUT_COORDINATE_SYSTEM_GRANULARITY_FFS_2)"
DEFAULT_MACRO FFS_OUT_FILE_DEST_DATASET_FFS_2 yes
FFS_2_FILE_DEST_DATASET "$(FFS_OUT_FILE_DEST_DATASET_FFS_2)"
# ============================================================================
FFS_2_GENERATE_FME_BUILD_NUM 26333
FFS_2_FEATURE_TABLE_FORMAT_ATTRS fme_color fme_fill_color
FFS_2_DATASET "$(DestDataset_FFS_2)"
