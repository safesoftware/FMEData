# -------------------------------------------------------------------------
OGCKML_2_DEF Neighborhoods   NeighborhoodId               kml_buffer   NeighborhoodName             kml_buffer   NeighborhoodURL              kml_buffer   TotalPopulation2001          kml_buffer   TotalPopulation2011          kml_buffer
# -------------------------------------------------------------------------
MITAB_2_DEF Parks   ParkId                       smallint   RefParkId                    smallint   ParkName                     char(40)   NeighborhoodName             char(40)   VisitorCount                 smallint   TreeCount                    smallint   DogPark                      char(1)   Washrooms                    char(1)   SpecialFeatures              char(1)
# -------------------------------------------------------------------------
GEOTIFF_3_DEF GEOTIFF
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE XLSXR XLSXR_2::Downtown multi_reader_keyword,$(DATASET_KEYWORD_XLSXR_2) TO FME_GENERIC ::Downtown ALIAS_GEOMETRY    ROUTE OGCKML OGCKML_2::Neighborhoods multi_reader_keyword,$(DATASET_KEYWORD_OGCKML_2) TO FME_GENERIC ::Neighborhoods ALIAS_GEOMETRY    ROUTE MITAB MITAB_2::Parks multi_reader_keyword,$(DATASET_KEYWORD_MITAB_2) TO FME_GENERIC ::Parks ALIAS_GEOMETRY    ROUTE GEOTIFF GEOTIFF_3::GEOTIFF multi_reader_keyword,$(DATASET_KEYWORD_GEOTIFF_3) TO FME_GENERIC ::GEOTIFF ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
XLSXR_2_MERGE_DEF XLSXR_2::Downtown GLOB * DEFLINE xlsx_start_row,,xlsx_end_row,,xlsx_apply_filters,No,fme_attribute_reading,all,Name,char<openparen>50<closeparen>,Title,char<openparen>50<closeparen>,Longitude,x_coordinate,Latitude,y_coordinate
OGCKML_2_MERGE_DEF OGCKML_2::Neighborhoods EXACT Neighborhoods
MITAB_2_MERGE_DEF MITAB_2::Parks EXACT Parks
GEOTIFF_3_MERGE_DEF GEOTIFF_3::GEOTIFF GLOB *
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "Neighborhoods_OGCKML_2 Splitter"    INPUT FEATURE_TYPE Neighborhoods    OUTPUT FEATURE_TYPE Neighborhoods_OGCKML_2
# -------------------------------------------------------------------------

