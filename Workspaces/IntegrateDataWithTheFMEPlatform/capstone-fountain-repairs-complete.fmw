#!   MERGE_FILTER_CASE_SENSITIVE="false"
#!   DYNAMIC_SCHEMA="false"
#! >
#!     <FEAT_GEOMETRY NAME="SHAPE" TYPE="geodb_point" SPATIAL_TYPE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="FountainID" ATTR_TYPE="smallint" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="Location" ATTR_TYPE="text(48)" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="Maintainer" ATTR_TYPE="text(16)" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="OBJECTID" ATTR_TYPE="largeint" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <DEFLINE_PARM PARM_NAME="openfilegdb_table_settings_group" PARM_VALUE=""/>
#!     <DEFLINE_PARM PARM_NAME="openfilegdb_where_wwjd" PARM_VALUE=""/>
#! </FEATURE_TYPE>
#! <FEATURE_TYPE
#!   IS_SOURCE="false"
#!   NODE_NAME="fountain-repairs"
#!   FEATURE_TYPE_NAME=""
#!   FEATURE_TYPE_NAME_QUALIFIER=""
#!   IS_EDITABLE="true"
#!   IDENTIFIER="3"
#!   POSITION="3950 -150"
#!   BOUNDING_RECT="3950 -150 430 71"
#!   ORDER="500000000000009"
#!   COLLAPSED="false"
#!   KEYWORD="GEOJSON_1"
#!   PARMS_EDITED="true"
#!   ENABLED="true"
#!   FEAT_GEOMTYPE="json_point"
#!   USES_SPATIAL_DEFINITION="true"
#!   SCHEMA_ATTRIBUTE_SOURCE="1"
#! >
#!     <FEAT_GEOMETRY NAME="" TYPE="json_point" SPATIAL_TYPE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="fountain_id" ATTR_TYPE="int" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="location" ATTR_TYPE="string" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="maintainer" ATTR_TYPE="string" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="status" ATTR_TYPE="string" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#!     <FEAT_ATTRIBUTE ATTR_NAME="inspected_on" ATTR_TYPE="string" ATTR_HAS_PORT="true" ATTR_VALUE=""/>
#! </FEATURE_TYPE>
#! </FEATURE_TYPES>
#! <FMESERVER>
#! <READER_DATASETS>
#! <DATASET
#!   NAME="OPENFILEGDB_1"
#!   OVERRIDE="-OPENFILEGDB_1_DATASET"
#!   DATASET="OPENFILEGDB_1/CommunityMap.gdb.zip"
#! />
#! </READER_DATASETS>
#! <WRITER_DATASETS>
#! <DATASET
#!   NAME="GEOJSON_1"
#!   OVERRIDE="-GEOJSON_1_DATASET"
#!   DATASET="GEOJSON_1/fountain-repairs.geojson"
#! />
#! </WRITER_DATASETS>
#! </FMESERVER>
#! <GLOBAL_PARAMETERS>
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI FILENAME DestDataset_GEOJSON GeoJSON_Files(*.json)|*.json|All_Files(*)|* Destination GeoJSON File"
#!   DEFAULT_VALUE="C:\FMEData\Output\Training\fountain-repairs.geojson"
#!   IS_STAND_ALONE="false"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
#!     <INFO NAME="DestDataset_GEOJSON" 
#!   DEFAULT_VALUE="C:\FMEData\Output\Training\fountain-repairs.geojson"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI FILENAME DestDataset_GEOJSON GeoJSON_Files(*.json)|*.json|All_Files(*)|* Destination GeoJSON File"
#! />
#! </PARAMETER_INFO>
#! </USER_PARAMETERS>
#! <COMMENTS>
#! <COMMENT
#!   IDENTIFIER="23"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Read the two sources.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;DrinkingFountains comes from CommunityMap.gdb: 113 points in UTM83-10.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The inspection records are JSON on the web, so HTTPCaller downloads FountainInspections.json into _response_body. JSONFragmenter splits it with the query json[&amp;quot;inspections&amp;quot;][*], giving one feature per inspection and flattening nested keys to names like fountain.id and result.status. AttributeExposer then exposes those attributes so the transformers downstream can use them.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="-1250 300"
#!   TOP_LEFT="-1250 300"
#!   BOTTOM_RIGHT="550 70"
#!   BOUNDING_RECT="-1250 300 1800 230"
#!   ORDER="500000000000080"
#!   FOLLOW_ANCHOR="false"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{a7b24f98-6c35-458c-b704-c9a08dccce0c}"
#!   COLOUR="0.32549019607843138,0.62352941176470589,0.92549019607843142,1"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="0"
#! />
#! <COMMENT
#!   IDENTIFIER="24"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Join each inspection to its fountain on FountainID = fountain.id.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;FeatureJoiner (Inner) keeps the Left geometry, so joined features take the fountain&amp;#x27;s point from the geodatabase, along with its Location and Maintainer.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;UnjoinedLeft: fountains nobody inspected (8). They are not needed.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;UnjoinedRight: inspections with no matching fountain (5). These are the new fountains.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="800 300"
#!   TOP_LEFT="800 300"
#!   BOTTOM_RIGHT="1500 110"
#!   BOUNDING_RECT="800 300 700 190"
#!   ORDER="500000000000081"
#!   FOLLOW_ANCHOR="false"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{b6a09416-e19f-4a5e-8cf9-781ce16f791b}"
#!   COLOUR="0.58039215686274515,0.65490196078431373,1,1"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="0"
#! />
#! <COMMENT
#!   IDENTIFIER="25"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;New fountains are not in the geodatabase, so there is no point to join to.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;VertexCreator builds each point from fountain.longitude and fountain.latitude and sets the coordinate system to LL84. AttributeManager then renames their attributes to match the joined fountains (FountainID, Location, Maintainer), so both streams line up.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="1450 -520"
#!   TOP_LEFT="1450 -520"
#!   BOTTOM_RIGHT="2600 -670"
#!   BOUNDING_RECT="1450 -520 1150 150"
#!   ORDER="500000000000082"
#!   FOLLOW_ANCHOR="false"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{3b2609a4-5e67-4aa5-9bed-9a8f99afd84d}"
#!   COLOUR="0.67843137254901964,0.88235294117647056,0.92156862745098034,1"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="0"
#! />
#! <COMMENT
#!   IDENTIFIER="26"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Merge both streams into one AttributeFilter on result.status.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Only the Needs Repair and Out of Service ports are connected. OK inspections stop here.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="2650 300"
#!   TOP_LEFT="2650 300"
#!   BOTTOM_RIGHT="3300 130"
#!   BOUNDING_RECT="2650 300 650 170"
#!   ORDER="500000000000083"
#!   FOLLOW_ANCHOR="false"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{10136099-bd32-4f95-adf6-e0bc5a0fb3ff}"
#!   COLOUR="0.81176470588235294,0.92941176470588238,0.81176470588235294,1"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="0"
#! />
#! <COMMENT
#!   IDENTIFIER="27"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Set the output schema and write GeoJSON.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;AttributeManager leaves exactly five attributes: fountain_id, location, maintainer, status, inspected_on.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The GeoJSON writer&amp;#x27;s Reproject to WGS84 parameter (Yes by default) converts every feature from its own coordinate system, so the UTM83-10 fountains and the LL84 new fountains both come out as longitude/latitude. No Reprojector is needed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="3300 300"
#!   TOP_LEFT="3300 300"
#!   BOTTOM_RIGHT="4450 130"
#!   BOUNDING_RECT="3300 300 1150 170"
#!   ORDER="500000000000084"
#!   FOLLOW_ANCHOR="false"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{41996b82-3742-409f-8f52-8c05d6e0b152}"
#!   COLOUR="0.67843137254901964,0.80784313725490198,0.72941176470588232,1"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="0"
#! />
#! </COMMENTS>
#! <CONSTANTS>
#! </CONSTANTS>
