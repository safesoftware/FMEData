DEFAULT_MACRO AverageLengthCalculator_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(AverageLengthCalculator_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(AverageLengthCalculator_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(AverageLengthCalculator_WORKSPACE_NAME)_Lines1786999317 Input Splitter"   INPUT FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_Lines"   OUTPUT FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_Lines"
# -------------------------------------------------------------------------
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(AverageLengthCalculator_WORKSPACE_NAME)_LengthCalculator_LengthCalculator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_Lines"    FUNCTION_DEFINITION { @Length(REJECTABLE,2,"1") }    RESULT_ATTRIBUTE { "_length" }    OUTPUT { COMPLETE FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_LengthCalculator_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StatisticsCalculatorFactory    FACTORY_NAME { $(AverageLengthCalculator_WORKSPACE_NAME)_StatisticsCalculator }    INPUT  FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_LengthCalculator_OUTPUT"    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    FEAT_STATS { _length,NUMERIC_MODE,,,,,MEAN,,,,,,,, }    ADVANCED_MODE { NO }    CUMULATIVE_STATS {  }    CALCULATION_MODE { NUMERIC }    ATTR_ACCUM_MODE { None }    ATTRIBUTE_NAMES_AND_TYPES { _length,real64 }    TREAT_INVALID_AS_NULL Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_StatisticsCalculator_COMPLETE"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(AverageLengthCalculator_WORKSPACE_NAME)_AttributeRenamer }    INPUT  FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_StatisticsCalculator_COMPLETE" 	ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    MISSING_INPUT_ATTR_HANDLING { RENAME_SET_DEFAULT REMOVE }    KEEP_OUTPUT_ATTRS_ONLY { no } 	ATTR_ACTION { "_length.mean" "AverageLength" "RENAME_SET_DEFAULT" "" }    OUTPUT { OUTPUT FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"        }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(AverageLengthCalculator_WORKSPACE_NAME)_Output1786999317 Output Collector"   INPUT FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"   OUTPUT FEATURE_TYPE "$(AverageLengthCalculator_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(AverageLengthCalculator_WORKSPACE_NAME))}]
