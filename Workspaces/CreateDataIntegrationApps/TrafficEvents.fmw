FME_PYTHON_VERSION 313
ARCGIS_COMPATIBILITY ARCGIS_AUTO
GUI IGNORE DestDataset_HTML_1
# ============================================================================
DEFAULT_MACRO date 20260930

DEFAULT_MACRO event_type HAZARD

DEFAULT_MACRO region drivebc.ca/1

DEFAULT_MACRO DestDataset_HTML C:\FMEData\Output\map.html

# ============================================================================
INCLUDE [ if {{$(date$encode)} == {}} { puts_real {Parameter 'date' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(event_type$encode)} == {}} { puts_real {Parameter 'event_type' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(region$encode)} == {}} { puts_real {Parameter 'region' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(DestDataset_HTML$encode)} == {}} { puts_real {Parameter 'DestDataset_HTML' must be given a value.}; exit 1; }; ]
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD PRIMARY_DEST
PRIMARY_DEST_DATASET_ORDER BY_ID
PRIMARY_DEST_FIRST_WRITER_ID 0
PRIMARY_DEST_TYPE{0} HTML
PRIMARY_DEST_KEYWORD{0} HTML_1
PRIMARY_DEST_GEN_DIRECTIVES{0} MIME_TYPE,text<solidus>html,COORDINATE_SYSTEM_GRANULARITY,FEATURE,WRITE_UTF8_BOM,YES,DESTINATION_DATASETTYPE_VALIDATION,Yes,ENCODING,UTF8,OVERWRITE_FILE,YES,ADD_WRITER_NEXT_ACTION,none,END_OF_LINE,System,WRITE_LAST_EOL,YES
#! END_WB_HEADER
#! START_WB_HEADER
MACRO WB_KEYWORD "HTML_1"
#! END_WB_HEADER
#! START_DEST_HEADER HTML HTML_1
# =====================================================================
# The following GUI line prompts for a folder to be used as the
# the destination for the TextLine files. The user input is stored in
# a macro, which is then used to define the dataset to be written.
#! END_DEST_HEADER
#! START_WB_HEADER
DEFAULT_MACRO DestDataset
INCLUDE [ if {"$(DestDataset)" != ""} {                          \
 puts {DEFAULT_MACRO DestDataset_HTML_1 $(DestDataset)}         \
 } ]
#! END_WB_HEADER
#! START_DEST_HEADER HTML HTML_1
DEFAULT_MACRO DestDataset_HTML_1 $(DestDataset_HTML)
GUI FILENAME DestDataset_HTML_1 HTML_Files(*.html)|*.html Destination Html File:
# =====================================================================
# The following GUI line prompts for the overwrite flag. The default is
# YES. Possible values are YES or NO. Any value other than NO or
# no is interpreted as YES.
DEFAULT_MACRO HTML_OUT_OVERWRITE_FILE_HTML_1 YES
HTML_1_OVERWRITE_FILE "$(HTML_OUT_OVERWRITE_FILE_HTML_1)"
# =====================================================================
# Set the type of encoding for the output files
# =====================================================================
# Set line termination character
DEFAULT_MACRO HTML_OUT_END_OF_LINE_HTML_1 System
HTML_1_END_OF_LINE "$(HTML_OUT_END_OF_LINE_HTML_1)"
# =====================================================================
# Set whether to write the last line termination character
DEFAULT_MACRO HTML_OUT_WRITE_LAST_EOL_HTML_1 YES
HTML_1_WRITE_LAST_EOL "$(HTML_OUT_WRITE_LAST_EOL_HTML_1)"
DEFAULT_MACRO HTML_OUT_ENCODING_HTML_1 UTF8
HTML_1_ENCODING "$(HTML_OUT_ENCODING_HTML_1)"
# =====================================================================
# The following GUI line prompts for the overwrite flag. The default is
# YES. Possible values are YES or NO. Any value other than NO or
# no is interpreted as YES.
DEFAULT_MACRO HTML_OUT_WRITE_UTF8_BOM_HTML_1 YES
HTML_1_WRITE_UTF8_BOM "$(HTML_OUT_WRITE_UTF8_BOM_HTML_1)"
# =====================================================================
# Set the mime type. Note -- it is actually only used inside of workspaces
# as a FORMAT_PARAMETER which even then is parsed only by the FME Server
# Repository Manager
DEFAULT_MACRO HTML_OUT_MIME_TYPE_HTML_1 text/html
HTML_1_MIME_TYPE "$(HTML_OUT_MIME_TYPE_HTML_1)"
# ============================================================================
# Opt in for destination dataset type vs format type validation
DEFAULT_MACRO HTML_OUT_DESTINATION_DATASETTYPE_VALIDATION_HTML_1 Yes
HTML_1_DESTINATION_DATASETTYPE_VALIDATION "$(HTML_OUT_DESTINATION_DATASETTYPE_VALIDATION_HTML_1)"
DEFAULT_MACRO HTML_OUT_COORDINATE_SYSTEM_GRANULARITY_HTML_1 FEATURE
HTML_1_COORDINATE_SYSTEM_GRANULARITY "$(HTML_OUT_COORDINATE_SYSTEM_GRANULARITY_HTML_1)"
# ============================================================================
HTML_1_GENERATE_FME_BUILD_NUM 25815
HTML_1_DATASET "$(DestDataset_HTML_1)"
#! END_DEST_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(FME_MF_DIR)$(WORKSPACE_NAME).log"
LOG_APPEND NO
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2026.1.2.0 (20260512 - Build 26124 - WIN64)"
DEFAULT_MACRO DATASET_KEYWORD_HTML_1 HTML_1
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO OpenAPICaller_FILE_PATH_ATTR
INCLUDE [ 	if { {<Unused>} == {<Unused>} } { 		puts {MACRO OpenAPICaller_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO OpenAPICaller_FILE_PATH_ATTR "<Unused>"}; 	}; 	if { {save_response} == {json_fragments} } { 		puts {MACRO OpenAPICaller_SAVE_FILE_LOOKUP NO}; 		puts {MACRO OpenAPICaller_TARGET_ATTR _response_body}; 		puts {MACRO OpenAPICaller_TARGET_ATTR_ENCODING utf-8} 	} else { 		puts {MACRO OpenAPICaller_SAVE_FILE_LOOKUP NO}; 		puts {MACRO OpenAPICaller_TARGET_ATTR _response_body}; 		puts {MACRO OpenAPICaller_TARGET_ATTR_ENCODING auto-detect} 	} ]
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { OpenAPICaller_Creator }    OUTPUT { FEATURE_TYPE OpenAPICaller_____CREATED______ }    
FACTORY_DEF {*} HTTPFactory    FACTORY_NAME { OpenAPICaller }       INPUT { FEATURE_TYPE OpenAPICaller_____CREATED______ }    TARGET_URL { "http:<solidus><solidus>api.open511.gov.bc.ca<solidus><solidus>events" }    HTTP_METHOD { GET }    SAVE_FILE { $(OpenAPICaller_SAVE_FILE_LOOKUP) }    OUTPUT_FILENAME { "<Unused>" }    OUTPUT_DIRECTORY { "<Unused>" }    FILE_EXTENSION { "<Unused>" }    TARGET_ATTR { "$(OpenAPICaller_TARGET_ATTR)" }    FILE_PATH_ATTR { $(OpenAPICaller_FILE_PATH_ATTR) }    UPLOAD_FILE { "<Unused>" }    UPLOAD_BODY { "<Unused>" }    UPLOAD_TYPE { <Unused> }    UPLOAD_CONTENT_TYPE { "<Unused>" }    COMBINED_MULTIPART_TABLE {  }    MULTIPART_CONTENT_TYPE { <Unused> }    REQUEST_HEADER_TABLE {  }    ADDITIONAL_URL_PARAMETERS { event_subtype;@EvaluateExpression(FDIV,STRING_ENCODED,$(event_type$encode),OpenAPICaller) area_id;@EvaluateExpression(FDIV,STRING_ENCODED,$(region$encode),OpenAPICaller) in_effect_on;@EvaluateExpression(FDIV,STRING_ENCODED,<at>DateTimeFormat<openparen>$(date$encode)<comma>%Y-%m-%dT00:00<closeparen><comma><at>DateTimeFormat<openparen>$(date$encode)<comma>%Y-%m-%dT23:59<closeparen>,OpenAPICaller) format;json status;ACTIVE limit;500 }    AUTH_USERNAME { "<Unused>" }    AUTH_PASSWORD { "<Unused>" }    AUTH_METHOD { "<Unused>" }    TARGET_ATTRIBUTE_ENCODING { $(OpenAPICaller_TARGET_ATTR_ENCODING) }    RESPONSE_HEADER_LIST_ATTR { "" }    STATUS_CODE_ATTR { "_http_status_code" }    ERROR_ATTR { "_error" }    CONNECTION_TIMEOUT_LENGTH { 60 }    TRANSFER_TIMEOUT_LENGTH { 90 }    FOLLOW_REDIRECTS { FOLLOW_WITH_GET }    REDIRECT_AUTH { ORIGINAL_DOMAIN_ONLY }    VERIFY_SSL_CERTIFICATES { Yes }    NAMED_CONNECTION { "<Unused>" }    USE_COOKIES { No }    MAX_TRANSFERS_IN_PROGRESS { 25 }    MAX_HTTP_VERSION { HTTP_2 }    RATE_LIMIT_MAX_REQUESTS { <Unused> }    RATE_LIMIT_INTERVAL_IN_SECONDS { <Unused> }    RATE_LIMIT_REQUEST_TIMING { <Unused> }    RETRY_FAILED_TRANSFERS { <Unused> }    RETRY_MAX_RETRIES { <Unused> }    RETRY_INITIAL_BACKOFF { <Unused> }    SPLIT_MULTIPART_RESPONSE { NO }    MULTIPART_RESPONSE_HEADER_LIST_ATTR { "<Unused>" }    MINIMUM_ENCRYPTION_LEVEL { "OS_DEFAULT" }    CLIENT_CERTIFICATE_TYPE { "NONE" }    CLIENT_CERTIFICATE_FROM_OS { "<Unused>" }    CLIENT_CERTIFICATE_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PRIVATE_KEY_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE OpenAPICaller_Output          }    OUTPUT { REJECTED FEATURE_TYPE OpenAPICaller_<REJECTED>          }
FACTORY_DEF {__DISABLED__} JSONQueryFactory    FACTORY_NAME OpenAPICaller_JSONFlattener    INPUT FEATURE_TYPE OpenAPICaller_Output    MODE FLATTEN    READ_FROM_FILE NO    JSON_DOCUMENT @Value(_response_body)    EXPLODE_QUERY "json"    RECURSIVE_FLATTEN YES    ERROR_LIST_ATTR _json_error    OUTPUT { EXPLODED FEATURE_TYPE OpenAPICaller_Output }    OUTPUT { REJECTED FEATURE_TYPE OpenAPICaller_<REJECTED>          }
FACTORY_DEF {__DISABLED__} JSONQueryFactory    FACTORY_NAME OpenAPICaller_JSONFragmenter    INPUT FEATURE_TYPE OpenAPICaller_Output    MODE EXPLODE    EXPLODE_FORMAT JSON    REJECT_EMPTY_LISTS YES    EXTRACT_ATTR Yes    JSON_ATTR _response_body    READ_FROM_FILE NO    EXPLODE_QUERY { "<Unused>" }    RECURSIVE_FLATTEN NO    OUTPUT { EXPLODED FEATURE_TYPE OpenAPICaller_Output }    OUTPUT { REJECTED FEATURE_TYPE OpenAPICaller_<REJECTED>          }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "OpenAPICaller_Output Brancher -1 9"   INPUT FEATURE_TYPE OpenAPICaller_Output   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
