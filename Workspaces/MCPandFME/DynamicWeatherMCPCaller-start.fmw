# -------------------------------------------------------------------------
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { MCPCaller_Creator }    OUTPUT { FEATURE_TYPE MCPCaller_____CREATED______ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { MCPCaller_CATCHER }    INPUT { FEATURE_TYPE MCPCaller_____CREATED______ }    OUTPUT { FEATURE_TYPE MCPCaller_READY       @SupplyAttributes(___XF_VERSION, 1)           ___XF_INPUT_SCHEMA_PREVIEW ""     ___XF_AUTH_METHOD NONE     ___XF_SERVER_URL http://weather-mcp:3000/mcp     ___XF_MCP_METHOD LIST_TOOLS     ___XF_OUTPUT_GROUPING INDIVIDUAL_FEATURES     ___XF_INCLUDE_RESPONSE_JSON NO     ___XF_TIMEOUT 30     INPUT_PORT_CONNECTED *    }
# Pass input feature to Python.
# Remove all internal attributes before emitting feature
# through the correct output port.
FACTORY_DEF {*} PythonFactory     FACTORY_NAME { MCPCaller }     INPUT { FEATURE_TYPE MCPCaller_READY }     SYMBOL_NAME fme_mcp.transformer.TransformerImpl     PY_OUTPUT_TAGS { Output ServerInfo <Rejected> }     OUTPUT { <Rejected> FEATURE_TYPE MCPCaller_<Rejected>         @RemoveAttributes(fme_pcre_match,^___XF_.*$|^INPUT_PORT_CONNECTED$)          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
