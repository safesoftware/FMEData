FME_PYTHON_VERSION 314
ARCGIS_COMPATIBILITY ARCGIS_AUTO
# ============================================================================
DEFAULT_MACRO USER_REQUEST Get<space>the<space>current<space>weather<space>forecast<space>for<space>Vancouver

# ============================================================================
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD MULTI_DEST
MULTI_DEST_DATASET null
#! END_WB_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(FME_MF_DIR)$(WORKSPACE_NAME).log"
LOG_APPEND NO
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2026.2.0.0 (20260617 - Build 26333 - macosx-aarch64)"
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { MCPCaller_Creator }    OUTPUT { FEATURE_TYPE MCPCaller_____CREATED______ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { MCPCaller_CATCHER }    INPUT { FEATURE_TYPE MCPCaller_____CREATED______ }    OUTPUT { FEATURE_TYPE MCPCaller_READY       @SupplyAttributes(___XF_VERSION, 1)           ___XF_INPUT_SCHEMA_PREVIEW ""     ___XF_AUTH_METHOD NONE     ___XF_SERVER_URL http://52.60.237.150:3000/mcp     ___XF_MCP_METHOD LIST_TOOLS     ___XF_OUTPUT_GROUPING INDIVIDUAL_FEATURES     ___XF_INCLUDE_RESPONSE_JSON NO     ___XF_TIMEOUT 30     INPUT_PORT_CONNECTED *    }
# Pass input feature to Python.
# Remove all internal attributes before emitting feature
# through the correct output port.
FACTORY_DEF {*} PythonFactory     FACTORY_NAME { MCPCaller }     INPUT { FEATURE_TYPE MCPCaller_READY }     SYMBOL_NAME fme_mcp.transformer.TransformerImpl     PY_OUTPUT_TAGS { Output ServerInfo <Rejected> }     OUTPUT { Output FEATURE_TYPE MCPCaller_Output         @RemoveAttributes(fme_pcre_match,^___XF_.*$|^INPUT_PORT_CONNECTED$)          }     OUTPUT { <Rejected> FEATURE_TYPE MCPCaller_<Rejected>         @RemoveAttributes(fme_pcre_match,^___XF_.*$|^INPUT_PORT_CONNECTED$)          }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "MCPCaller_Output Brancher -1 13"   INPUT FEATURE_TYPE MCPCaller_Output   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME MCPCaller_<Rejected> INPUT FEATURE_TYPE MCPCaller_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, MCPCaller<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { MCPCaller_2_Creator }    OUTPUT { FEATURE_TYPE MCPCaller_2_____CREATED______ }
